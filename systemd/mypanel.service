[Unit]
Description=mypanel personal server control panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/mypanel/src
Environment=MYPANEL_HOME=/etc/mypanel
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m mypanel serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# Runs as root on purpose (manages services, nginx, ufw). These limit the blast radius:
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
