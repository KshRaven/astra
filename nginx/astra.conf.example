# Windows: same idea with nginx for Windows (conf\\ folder, forward slashes in paths, certificates from win-acme or certbot).
# Optional: put the panel behind nginx with HTTPS and an IP allowlist.
# Keep astra bound to 127.0.0.1:8800 (the default).
server {
    listen 443 ssl http2;
    server_name panel.example.com;

    ssl_certificate     /etc/letsencrypt/live/panel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Only your own addresses (also stops brute-force attempts reaching the panel):
    allow 203.0.113.10;
    deny  all;

    client_max_body_size 12m;   # matches the panel's upload limit

    location / {
        proxy_pass http://127.0.0.1:8800;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

# Same host, panel under a path (works because the panel also answers under /astra/):
#   location /astra/ {
#       proxy_pass http://127.0.0.1:8800;      # no trailing slash: the prefix is kept, the panel handles it
#       proxy_set_header Host $host;
#   }
